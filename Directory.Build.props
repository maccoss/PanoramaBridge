<Project>

  <!--
    Single source of truth for the product version.

    CalVer, YY.feature.patch:
      YY       two-digit year (26 = 2026)
      feature  incremented for each release containing new features, restarting each year
      patch    incremented for bug-fix-only releases within the same feature version

    This value and the git tag must match: release.yml refuses to publish when
    tag v<version> disagrees with this property. Bump it here, commit, then tag.
  -->
  <PropertyGroup>
    <Version>26.4.6</Version>
    <Product>PanoramaBridge</Product>
    <Company>MacCoss Lab, University of Washington</Company>
    <Authors>MacCoss Lab, University of Washington</Authors>
    <Copyright>Copyright (c) MacCoss Lab, University of Washington</Copyright>
    <RepositoryUrl>https://github.com/maccoss/PanoramaBridge</RepositoryUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      InvariantGlobalization must stay OFF: WPF data binding calls
      XmlLanguage.GetSpecificCulture(), which throws "Cannot find non-neutral culture"
      without real ICU culture data.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
  </PropertyGroup>

  <!-- Deterministic builds in CI -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
