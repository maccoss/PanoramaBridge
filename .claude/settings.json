{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/release-note-check.py\" 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Checking for a release note"
          }
        ]
      }
    ]
  }
}
