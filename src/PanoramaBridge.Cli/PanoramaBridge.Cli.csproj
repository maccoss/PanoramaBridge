<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PanoramaBridge.Cli</RootNamespace>
    <AssemblyName>pbctl</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PanoramaBridge.Core\PanoramaBridge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The harness has no public surface and should not grow one just to be tested. Its argument
      parsing and path resolution are real logic and are worth testing directly.
    -->
    <InternalsVisibleTo Include="PanoramaBridge.Tests" />
  </ItemGroup>

</Project>
