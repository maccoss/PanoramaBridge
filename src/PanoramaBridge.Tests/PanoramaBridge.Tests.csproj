<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net8.0-windows rather than net8.0 so the WPF shell can be tested at all. The suite was
      already Windows-only in practice - WindowsCredentialStore and NetworkPaths both P/Invoke -
      and CI runs windows-latest, so this costs nothing that was not already spent. UseWPF is
      needed for the dispatcher and timer types the view models build on.
    -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>PanoramaBridge.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />

    <!--
      UseWPF drops System.IO and System.Net.Http from the implicit usings, because
      System.IO.Path collides with System.Windows.Shapes.Path. That is the right call for the
      App project, which draws things; here nothing does, so putting them back project-wide
      costs nothing and saves the churn of importing them in every test file.
    -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PanoramaBridge.Core\PanoramaBridge.Core.csproj" />
    <ProjectReference Include="..\PanoramaBridge.App\PanoramaBridge.App.csproj" />
    <ProjectReference Include="..\PanoramaBridge.Cli\PanoramaBridge.Cli.csproj" />
  </ItemGroup>

</Project>
