<Window x:Class="PanoramaBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PanoramaBridge.App.ViewModels"
        xmlns:views="clr-namespace:PanoramaBridge.App.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Height="720" Width="1080"
        MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen">

    <!--
        Overall progress on the taskbar button, so someone can leave the window minimised during
        a long transfer and still see where it is up to.
    -->
    <Window.TaskbarItemInfo>
        <shell:TaskbarItemInfo
            ProgressState="{Binding IsBusy, Converter={StaticResource EnumMatch}, ConverterParameter=Normal, Mode=OneWay, FallbackValue=None}"
            ProgressValue="{Binding TransferStatus.OverallProgress, FallbackValue=0, TargetNullValue=0}" />
    </Window.TaskbarItemInfo>

    <DockPanel LastChildFill="True">

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_View">
                <MenuItem Header="Application _logs" Command="{Binding OpenLogFolderCommand}" />
                <MenuItem Header="_Data folder" Command="{Binding OpenDataFolderCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Check for _updates" Command="{Binding CheckForUpdatesCommand}" />
                <Separator />
                <MenuItem Header="_About" Command="{Binding ShowAboutCommand}" />
            </MenuItem>
        </Menu>

        <!--
            Blocking banner. Shown only when this build is below the published minimum supported
            version, in which case no new upload may start.
        -->
        <Border DockPanel.Dock="Top" Background="#B3261E" Padding="14,10"
                Visibility="{Binding UploadsBlocked, Converter={StaticResource BooleanToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Update and restart" Margin="12,0,0,0"
                        Command="{Binding ApplyUpdateCommand}" />
                <TextBlock Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="{Binding UpdateDetail}" />
            </DockPanel>
        </Border>

        <!-- Informational strip: an update is staged and will apply on the next restart. -->
        <Border DockPanel.Dock="Top" Background="#1F6FEB" Padding="14,8"
                Visibility="{Binding ShowUpdateBanner, Converter={StaticResource BooleanToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Restart now" Margin="12,0,0,0"
                        Command="{Binding ApplyUpdateCommand}" />
                <TextBlock Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="{Binding UpdateSummary}" />
            </DockPanel>
        </Border>

        <!-- Command bar. -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                Padding="12,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="{Binding MonitoringButtonText}" Style="{StaticResource ToolbarButton}"
                            Command="{Binding ToggleMonitoringCommand}" />
                    <Button Content="{Binding UploadNowButtonText}" Style="{StaticResource ToolbarButton}"
                            Command="{Binding UploadNowCommand}" IsDefault="True" />
                    <Button Content="Stop" Style="{StaticResource ToolbarButton}"
                            Command="{Binding CancelCommand}" />
                    <Button Content="Test connection" Style="{StaticResource ToolbarButton}"
                            Command="{Binding TestConnectionCommand}" />
                    <Button Content="Save settings" Style="{StaticResource ToolbarButton}"
                            Command="{Binding SaveSettingsCommand}" />
                </StackPanel>

                <ProgressBar DockPanel.Dock="Right" Width="160" Height="6" Margin="12,0,0,0"
                             VerticalAlignment="Center" IsIndeterminate="False"
                             Maximum="1"
                             Value="{Binding TransferStatus.OverallProgress, Mode=OneWay, FallbackValue=0, TargetNullValue=0}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />

                <TextBlock VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis"
                           Text="{Binding TransferStatus.Summary}" Opacity="0.8" />
            </DockPanel>
        </Border>

        <!-- Status line: the outcome of the last command, and any connection detail. -->
        <Border DockPanel.Dock="Bottom" Padding="12,6,12,0">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Text="{Binding StatusLine}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ConnectionFailed}" Value="True">
                                    <Setter Property="Foreground" Value="#B3261E" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Style="{StaticResource Hint}" Text="{Binding ConnectionDetail}" />
            </StackPanel>
        </Border>

        <TabControl Margin="8" Padding="12">
            <TabItem Header="Local Monitoring">
                <views:LocalMonitoringView DataContext="{Binding Settings}" />
            </TabItem>
            <TabItem Header="Remote Settings">
                <views:RemoteSettingsView x:Name="RemoteSettings" DataContext="{Binding Settings}" />
            </TabItem>
            <TabItem Header="Transfer Status">
                <views:TransferStatusView DataContext="{Binding TransferStatus}" />
            </TabItem>
            <TabItem Header="Uploads">
                <views:UploadsView DataContext="{Binding Uploads}" />
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>
