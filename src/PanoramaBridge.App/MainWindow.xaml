<Window x:Class="PanoramaBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PanoramaBridge.App.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PanoramaBridge"
        Height="480" Width="760"
        MinHeight="360" MinWidth="560"
        WindowStartupLocation="CenterScreen">

    <DockPanel LastChildFill="True">

        <!-- Blocking banner: shown only when this build is below the published version floor. -->
        <Border DockPanel.Dock="Top"
                Background="#B3261E"
                Padding="14,10"
                Visibility="{Binding UploadsBlocked, Converter={StaticResource BooleanToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Update and restart"
                        Padding="12,4"
                        Margin="12,0,0,0"
                        Command="{Binding ApplyUpdateCommand}" />
                <TextBlock Foreground="White"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Text="{Binding UpdateDetail}" />
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding UpdateSummary}" />
            </StatusBarItem>
        </StatusBar>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>

                <TextBlock Text="PanoramaBridge" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Margin="0,2,0,18" Opacity="0.75"
                           Text="Monitors local directories and transfers acquisitions to Panorama." />

                <GroupBox Header="This build" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Version" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding Version}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Platform" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding RuntimeIdentifier}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Install" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding InstallKind}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Data" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldValue}"
                                   Text="{Binding DataDirectory}" ToolTip="{Binding DataDirectory}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Logs" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldValue}"
                                   Text="{Binding LogDirectory}" ToolTip="{Binding LogDirectory}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Updates" Padding="12" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding UpdateSummary}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding UpdateDetail}" TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Check now" Padding="12,4"
                                    Command="{Binding CheckForUpdatesCommand}" />
                            <Button Content="Restart to apply" Padding="12,4" Margin="8,0,0,0"
                                    Command="{Binding ApplyUpdateCommand}" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button Content="Open data folder" Padding="12,4"
                            Command="{Binding OpenDataFolderCommand}" />
                    <Button Content="Open log folder" Padding="12,4" Margin="8,0,0,0"
                            Command="{Binding OpenLogFolderCommand}" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>
