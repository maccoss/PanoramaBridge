<Application x:Class="PanoramaBridge.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:PanoramaBridge.App.Views">
    <Application.Resources>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <app:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" />
        <app:NullableDoubleToVisibilityConverter x:Key="NullableToVisibility" />
        <app:EnumMatchConverter x:Key="EnumMatch" />

        <!-- Layout constants, so spacing is consistent rather than sprinkled per control. -->
        <Thickness x:Key="RowMargin">0,0,0,8</Thickness>
        <Thickness x:Key="GroupMargin">0,0,0,16</Thickness>
        <Thickness x:Key="GroupPadding">12</Thickness>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="{StaticResource GroupPadding}" />
            <Setter Property="Margin" Value="{StaticResource GroupMargin}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="MinWidth" Value="92" />
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

    </Application.Resources>
</Application>
