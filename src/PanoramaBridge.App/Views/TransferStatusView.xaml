<UserControl x:Class="PanoramaBridge.App.Views.TransferStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PanoramaBridge.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TransferStatusViewModel}"
             d:DesignHeight="600" d:DesignWidth="1000">

    <DockPanel LastChildFill="True">

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Clear finished"
                    Command="{Binding ClearCompletedCommand}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding Summary}" />
        </DockPanel>

        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="10,6" Background="#FFF4E5"
                Visibility="{Binding HasAttentionItems, Converter={StaticResource BooleanToVisibility}}">
            <!--
                This says what to do, not just that something is wrong. It used to end at "see the
                reason on each row", which tells someone where to look and not what to do about it
                - and the state on those rows read "Needs a decision", naming per-file buttons
                that were removed in v26.5.0. Between them the window asked for an action it no
                longer offered anywhere.
            -->
            <TextBlock TextWrapping="Wrap" Foreground="#663C00">
                <Run Text="{Binding AttentionCount, Mode=OneWay}" />
                <Run Text="transfer(s) need attention, and none of them is being retried silently. Each row says which it is, and why, under Detail." />
                <LineBreak />
                <Run Text="Held means something different is already on the server. Choose what should happen on the Local Monitoring tab, under &quot;When a different file is already on the server&quot;, and save. If monitoring is running, stop it and start it again - the setting is read when monitoring starts, so saving alone will not move files that are already held. It then applies to every file held for that reason. To settle one file on its own, rename or move it instead." />
                <LineBreak />
                <Run Text="Held - damaged means reading the file showed it ends before its data does. No setting sends that one; replace the file and it is picked up on its own." />
                <LineBreak />
                <Run Text="Cannot be placed means there is nowhere on the server the file belongs - usually it is not inside the folder being monitored, or its name is one Panorama would mangle. The row says what would change that, and it is not tried again until the file or the setting changes." />
                <LineBreak />
                <Run Text="Failed is an upload that started and did not finish. Those are tried again on their own until their attempts run out, and then they stop and wait for you." />
            </TextBlock>
        </Border>

        <!--
            Virtualization is essential here: a monitored folder can hold thousands of
            acquisitions. Recycling mode reuses row containers, and a fixed row height is what
            lets the scroll bar be computed without measuring every row.
        -->
        <DataGrid ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Single"
                  RowHeight="26"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Item"
                  ScrollViewer.CanContentScroll="True">

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                            <Setter Property="Background" Value="#FDECEA" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open containing folder"
                              Command="{Binding OpenContainingFolderCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                 RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130" />

                <DataGridTemplateColumn Header="Progress" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ProgressBar Height="10" Minimum="0" Maximum="100"
                                         Value="{Binding Percent, Mode=OneWay}"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding HasProgress, Converter={StaticResource BooleanToVisibility}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Speed" Binding="{Binding Speed}" Width="90" />
                <DataGridTextColumn Header="Left" Binding="{Binding Eta}" Width="70" />
                <DataGridTextColumn Header="Checked" Binding="{Binding Verification}" Width="150" />

                <!-- Carries the reason a row is waiting, skipped, conflicted or failed. -->
                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="3*" />
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</UserControl>
