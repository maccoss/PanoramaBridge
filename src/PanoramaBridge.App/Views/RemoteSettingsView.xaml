<UserControl x:Class="PanoramaBridge.App.Views.RemoteSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PanoramaBridge.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignHeight="600" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <GroupBox Header="Panorama server">
                <StackPanel>
                    <TextBox Margin="{StaticResource RowMargin}"
                             Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Certificates are always validated. If your site uses a TLS-inspecting proxy, add its root certificate below rather than turning checking off - there is no option to do that." />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Sign in">
                <StackPanel>
                    <RadioButton Margin="{StaticResource RowMargin}" GroupName="Auth"
                                 Content="API key (recommended)"
                                 IsChecked="{Binding AuthMode, Converter={StaticResource EnumMatch}, ConverterParameter=ApiKey}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,8"
                               Text="An API key can be revoked without changing your account password, can be limited to a role, and expires on its own. Safer than a password on a shared instrument PC." />

                    <RadioButton Margin="{StaticResource RowMargin}" GroupName="Auth"
                                 Content="User name and password"
                                 IsChecked="{Binding AuthMode, Converter={StaticResource EnumMatch}, ConverterParameter=UserNameAndPassword}" />

                    <Grid Margin="0,8,0,0"
                          Visibility="{Binding IsApiKey, Converter={StaticResource InverseBooleanToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="User name" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}"
                                   Text="{Binding SecretLabel}" />

                        <!--
                            Not bound. The secret stays in this control and is read only at the
                            moment a command needs it, so it never becomes part of the view model,
                            anything serialized, or a diagnostic dump.
                        -->
                        <PasswordBox x:Name="SecretBox" Grid.Column="1" Padding="4,3" />

                        <Button Grid.Column="2" Margin="8,0,0,0" Content="Get a key"
                                Command="{Binding OpenApiKeyPageCommand}"
                                Visibility="{Binding IsApiKey, Converter={StaticResource BooleanToVisibility}}" />
                    </Grid>

                    <CheckBox Margin="0,10,0,0"
                              Content="Remember this in Windows Credential Manager"
                              IsChecked="{Binding SaveCredentials}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Stored by Windows, encrypted for your account, and removable from Control Panel. It is never written to PanoramaBridge's own settings file." />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Where to upload">
                <StackPanel>
                    <DockPanel Margin="{StaticResource RowMargin}">
                        <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0"
                                Click="BrowseRemote_Click" />
                        <ComboBox IsEditable="True"
                                  Text="{Binding RemotePath, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding RecentRemotePaths}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="The MacCoss lab folder is offered by default. The local folder structure below the monitored directory is mirrored here." />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Transfers">
                <StackPanel>
                    <Grid Margin="{StaticResource RowMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}"
                                   Text="Files at once" />
                        <Slider Grid.Column="1" Minimum="1" Maximum="8" TickFrequency="1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Value="{Binding MaxConcurrentTransfers}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}"
                                   Text="{Binding MaxConcurrentTransfers}" />
                        <TextBlock Grid.Column="3" Style="{StaticResource Hint}" Margin="12,0,0,0"
                                   Text="{Binding ConcurrencyAdvice}" />
                    </Grid>

                    <CheckBox Content="Check every upload against the server's own hash"
                              IsChecked="{Binding VerifyUploads}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                               Text="Costs one extra request per file and is the only thing that makes a green tick mean anything. Turning it off is not recommended." />

                    <CheckBox Content="Write a .md5 file beside each upload"
                              IsChecked="{Binding WriteChecksumSidecars}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="A small text file next to each uploaded file, holding its checksum and the date the instrument wrote it, in the format md5sum reads. It is the only record that travels with the data: PanoramaBridge's own database stays on this computer, and Panorama stamps an uploaded file with the time it arrived rather than the time it was collected." />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Advanced">
                <StackPanel>
                    <DockPanel Margin="{StaticResource RowMargin}">
                        <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0"
                                Command="{Binding BrowseCertificateCommand}" />
                        <TextBox Text="{Binding TrustedRootCertificatePath, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                               Text="Optional additional root certificate, trusted in addition to the ones Windows already trusts." />

                    <CheckBox Content="Verbose logging" IsChecked="{Binding VerboseLogging}" />
                    <CheckBox Margin="0,6,0,0" Content="Keep running in the notification area when closed"
                              IsChecked="{Binding MinimizeToTray}" />
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
