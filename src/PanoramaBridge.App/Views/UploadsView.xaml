<UserControl x:Class="PanoramaBridge.App.Views.UploadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PanoramaBridge.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:UploadsViewModel}"
             d:DesignHeight="600" d:DesignWidth="1000">

    <DockPanel LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                       Text="The durable record of what reached the server. Survives a restart, so it still answers the question next week or on a rebuilt machine." />

            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Refresh" Style="{StaticResource ToolbarButton}"
                            Command="{Binding RefreshCommand}" />
                    <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <ComboBox Width="150" VerticalAlignment="Center"
                              SelectedValue="{Binding Filter}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="Everything" Tag="{x:Static vm:UploadFilter.All}" />
                        <ComboBoxItem Content="On the server" Tag="{x:Static vm:UploadFilter.Verified}" />
                        <ComboBoxItem Content="Needs attention" Tag="{x:Static vm:UploadFilter.NeedsAttention}" />
                        <ComboBoxItem Content="Not checked" Tag="{x:Static vm:UploadFilter.NotChecked}" />
                    </ComboBox>

                    <TextBox Width="220" Margin="8,0,0,0" VerticalAlignment="Center"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="8,0,0,0" Text="Search by file name" />
                </StackPanel>
            </DockPanel>

            <TextBlock Margin="0,8,0,0" Text="{Binding Summary}" />

            <!--
                Shown only when there is something to decide. A row of buttons that is nearly
                always disabled teaches people to ignore it, and this one matters on the days it
                appears.

                Nothing here interrupts a transfer: conflicts wait in the ledger until somebody
                is at the machine. A modal on an instrument PC at three in the morning would turn
                one held file into a stalled night.
            -->
            <Border Margin="0,10,0,0" Padding="10" CornerRadius="3"
                    Background="#FFF7E6" BorderBrush="#E0C48C" BorderThickness="1"
                    Visibility="{Binding HasConflicts, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap"
                               Text="Some files were held because something different already occupies their destination. Tick the ones you want to decide about, or leave everything unticked to decide about all of them." />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Replace what is on the server"
                                Command="{Binding ResolveOverwriteCommand}" />
                        <Button Content="Send alongside, under a new name" Margin="8,0,0,0"
                                Command="{Binding ResolveRenameCommand}" />
                        <Button Content="Keep what is on the server" Margin="8,0,0,0"
                                Command="{Binding ResolveKeepCommand}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="A file whose own contents are damaged is held here too, and only Keep applies to it: replacing a good remote copy with a short one is the thing this check exists to prevent." />

                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#A32100"
                               Text="{Binding RenameProblem}"
                               Visibility="{Binding HasRenameProblem, Converter={StaticResource BooleanToVisibility}}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                   Text="Nothing recorded yet. Run a transfer and it will appear here."
                   Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}" />

        <DataGrid ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Extended"
                  RowHeight="26"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True">

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                            <Setter Property="Background" Value="#FDECEA" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <!--
                    Editable in an otherwise read-only grid, which is why IsReadOnly is set on the
                    column rather than left to inherit. Ticking a row is not editing the ledger.
                -->
                <DataGridCheckBoxColumn Header="" Width="34" IsReadOnly="False"
                                        Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridCheckBoxColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="ToolTip" Value="Pick this file to decide about" />
                            <Style.Triggers>
                                <!-- Only a conflict is something a person can decide about. -->
                                <DataTrigger Binding="{Binding CanResolve}" Value="False">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="ToolTip" Value="{x:Null}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridCheckBoxColumn.CellStyle>
                </DataGridCheckBoxColumn>

                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*" />
                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="130" />

                <!--
                    Stated rather than implied. A tick that only means "the byte count matched" is
                    how upload tracking loses trust, so the column says exactly what was checked.
                -->
                <DataGridTextColumn Header="Checked" Binding="{Binding Verification}" Width="110">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTrustworthy}" Value="False">
                                    <Setter Property="Foreground" Value="#8A6100" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <!-- What reading the file itself established. Blank for formats with nothing
                     to ask, which is most of them. -->
                <DataGridTextColumn Header="File check" Binding="{Binding RawCheck}" Width="170" />

                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="90" />
                <DataGridTextColumn Header="Verified" Binding="{Binding VerifiedAt}" Width="130" />
                <DataGridTextColumn Header="Remote path" Binding="{Binding RemotePath}" Width="3*" />
                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</UserControl>
