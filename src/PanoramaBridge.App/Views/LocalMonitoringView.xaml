<UserControl x:Class="PanoramaBridge.App.Views.LocalMonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PanoramaBridge.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignHeight="600" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <GroupBox Header="Directory to monitor">
                <StackPanel>
                    <DockPanel Margin="{StaticResource RowMargin}">
                        <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0"
                                Command="{Binding BrowseLocalDirectoryCommand}" />
                        <TextBox Text="{Binding LocalDirectory, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <CheckBox Content="Include subdirectories"
                              IsChecked="{Binding IncludeSubdirectories}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="A folder on a file server works too. Prefer the full network path over a mapped drive letter: drive letters belong to a single Windows sign-in, so a path like Y:\ will not resolve if PanoramaBridge is ever started as a service or scheduled task." />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="File types">
                <StackPanel>
                    <DockPanel Margin="{StaticResource RowMargin}">
                        <Button DockPanel.Dock="Right" Content="Defaults" Margin="8,0,0,0"
                                Command="{Binding RestoreDefaultExtensionsCommand}" />
                        <TextBox Text="{Binding ExtensionsText, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Comma-separated. Matched against the file extension exactly, so .raw does not also match archive.notraw." />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="When is a file finished?">
                <StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                               Text="A file is only uploaded once nothing else holds it open AND its size has stopped changing. Both checks are needed: an instrument often leaves its output readable while still writing, and Windows does not keep a file's recorded size up to date while a write handle is open." />

                    <Grid Margin="{StaticResource RowMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}"
                                   Text="Unchanged for (seconds)" />
                        <TextBox Grid.Column="1" Text="{Binding StabilitySeconds}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}"
                                   Text="Re-check the folder every (minutes)" />
                        <TextBox Grid.Column="1" Text="{Binding ReconcileMinutes}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Hint}" Margin="12,0,0,0"
                                   Text="Always on. File system notifications get dropped under load and are unreliable over network shares, so the periodic sweep is the real safety net." />
                    </Grid>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Files held open by an instrument">
                <StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                               Text="An instrument holds its output file for the whole of a run, so the first re-check waits a long time by default rather than burning requests on a file that cannot be read yet." />

                    <Grid Margin="{StaticResource RowMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}"
                                   Text="First re-check after (minutes)" />
                        <TextBox Grid.Column="1" Text="{Binding LockedFileInitialWaitMinutes}" />
                    </Grid>

                    <Grid Margin="{StaticResource RowMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}"
                                   Text="Then every (seconds)" />
                        <TextBox Grid.Column="1" Text="{Binding LockedFileRetryIntervalSeconds}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}"
                                   Text="Give up after (attempts)" />
                        <TextBox Grid.Column="1" Text="{Binding LockedFileMaxRetries}" />
                    </Grid>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="When a different file is already on the server">
                <StackPanel>
                    <RadioButton Margin="{StaticResource RowMargin}" GroupName="Conflict"
                                 Content="Ask me"
                                 IsChecked="{Binding ConflictPolicy, Converter={StaticResource EnumMatch}, ConverterParameter=Ask}" />
                    <RadioButton Margin="{StaticResource RowMargin}" GroupName="Conflict"
                                 Content="Leave the copy on the server alone"
                                 IsChecked="{Binding ConflictPolicy, Converter={StaticResource EnumMatch}, ConverterParameter=Skip}" />
                    <RadioButton GroupName="Conflict"
                                 Content="Replace the copy on the server"
                                 IsChecked="{Binding ConflictPolicy, Converter={StaticResource EnumMatch}, ConverterParameter=Overwrite}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="This only applies to a file nobody can account for. Editing a file that PanoramaBridge uploaded itself is treated as a new version and re-sent without asking." />
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
