<UserControl x:Class="PanoramaBridge.App.Views.LocalMonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PanoramaBridge.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignHeight="600" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <GroupBox Header="Directory to monitor">
                <StackPanel>
                    <DockPanel Margin="{StaticResource RowMargin}">
                        <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0"
                                Command="{Binding BrowseLocalDirectoryCommand}" />
                        <TextBox Text="{Binding LocalDirectory, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <CheckBox Content="Include subdirectories"
                              IsChecked="{Binding IncludeSubdirectories}" />
                    <CheckBox Margin="0,6,0,0"
                              Content="Send acquisition folders as a single archive (Bruker and Agilent .d, Waters .raw)"
                              IsChecked="{Binding FolderAcquisitions}" />
                    <TextBlock Style="{StaticResource Hint}"
                               TextWrapping="Wrap"
                               Text="Leave this off unless you have one of those instruments. The MacCoss Lab runs Thermo only, so this has never been exercised against a real instrument writing an acquisition: packing and naming were checked against real data downloaded from Panorama, but deciding when a folder has finished being written was not. With it off, such a folder is treated as an ordinary folder and the files inside are sent individually." />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="A folder on a file server works too. Pick a mapped drive and PanoramaBridge records the full network path instead, because a drive letter belongs to a single Windows sign-in and would not resolve if PanoramaBridge were ever started as a service or scheduled task." />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="Choose the folder your instrument writes into rather than the top of a shared drive. Every re-check walks the whole folder, and over the network that takes about half a minute for thirty thousand files." />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="File types">
                <StackPanel>
                    <DockPanel Margin="{StaticResource RowMargin}">
                        <Button DockPanel.Dock="Right" Content="Defaults" Margin="8,0,0,0"
                                Command="{Binding RestoreDefaultExtensionsCommand}" />
                        <TextBox Text="{Binding ExtensionsText, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Comma-separated. Matched against the file extension exactly, so .raw does not also match archive.notraw." />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="When is a file finished?">
                <StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                               Text="A file is only uploaded once nothing else holds it open AND its size has stopped changing. Both checks are needed: an instrument often leaves its output readable while still writing, and Windows does not keep a file's recorded size up to date while a write handle is open." />

                    <Grid Margin="{StaticResource RowMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}"
                                   Text="Unchanged for (seconds)" />
                        <TextBox Grid.Column="1" Text="{Binding StabilitySeconds}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}"
                                   Text="Re-check the folder every (minutes)" />
                        <TextBox Grid.Column="1" Text="{Binding ReconcileMinutes}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Hint}" Margin="12,0,0,0"
                                   Text="Always on. File system notifications get dropped under load and are unreliable over network shares, so the periodic sweep is the real safety net." />
                    </Grid>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Files held open by an instrument">
                <StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                               Text="An instrument holds its output file for the whole of a run. PanoramaBridge keeps looking at it, slowly, because the only way to find out that a file has been released is to try." />

                    <Grid Margin="{StaticResource RowMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}"
                                   Text="Look again every (seconds)" />
                        <TextBox Grid.Column="1" Text="{Binding LockedFileRetryIntervalSeconds}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Hint}" Margin="12,0,0,0"
                                   Text="Also how long you may wait for a finished file to start transferring." />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}"
                                   Text="Stop watching closely after (checks)" />
                        <TextBox Grid.Column="1" Text="{Binding LockedFileMaxRetries}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Hint}" Margin="12,0,0,0"
                                   Text="The file is not forgotten. It goes back to the folder check above, which offers it again on its next pass." />
                    </Grid>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="When a different file is already on the server">
                <StackPanel>
                    <RadioButton Margin="{StaticResource RowMargin}" GroupName="Conflict"
                                 Content="Ask me"
                                 IsChecked="{Binding ConflictPolicy, Converter={StaticResource EnumMatch}, ConverterParameter=Ask}" />
                    <RadioButton Margin="{StaticResource RowMargin}" GroupName="Conflict"
                                 Content="Leave the copy on the server alone"
                                 IsChecked="{Binding ConflictPolicy, Converter={StaticResource EnumMatch}, ConverterParameter=Skip}" />
                    <RadioButton GroupName="Conflict"
                                 Content="Replace the copy on the server"
                                 IsChecked="{Binding ConflictPolicy, Converter={StaticResource EnumMatch}, ConverterParameter=Overwrite}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="This only applies to a file nobody can account for. Editing a file that PanoramaBridge uploaded itself is treated as a new version and re-sent without asking." />
                </StackPanel>
            </GroupBox>

            <!--
                Neither of these is a remote setting, and both sat under Remote Settings /
                Advanced next to a trusted-root certificate path because there was nowhere else.
                They describe how the program behaves on this machine, which is what this tab is,
                so they live here rather than beside a TLS option they have nothing to do with.
            -->
            <GroupBox Header="This application">
                <StackPanel>
                    <CheckBox Content="Keep running in the notification area when closed"
                              IsChecked="{Binding MinimizeToTray}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                               Text="Closing the window leaves PanoramaBridge running and, if it was monitoring, still watching. Click its icon to bring the window back, or use Exit on the icon's menu to stop it." />

                    <CheckBox Content="Verbose logging" IsChecked="{Binding VerboseLogging}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Records every decision rather than the important ones. Useful when reporting a problem; it takes effect immediately, without a restart." />
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
