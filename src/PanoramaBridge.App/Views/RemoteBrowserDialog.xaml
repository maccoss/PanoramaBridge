<Window x:Class="PanoramaBridge.App.Views.RemoteBrowserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PanoramaBridge.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:RemoteBrowserViewModel}"
        Title="Choose a folder on Panorama"
        Height="560" Width="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <DockPanel Margin="12" LastChildFill="True">

        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                   Text="Folders you cannot upload to are greyed out. Knowing that now beats finding out at the end of a long transfer." />

        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
                    <Button Content="Choose" IsDefault="True" Click="Choose_Click"
                            IsEnabled="{Binding CanAccept}" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="{Binding AcceptHint}" />
            </DockPanel>
        </Border>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="New folder" Margin="8,0,0,0"
                    Click="NewFolder_Click" IsEnabled="{Binding CanAccept}" />
            <TextBox x:Name="NewFolderName" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" Foreground="#B3261E" TextWrapping="Wrap"
                   Margin="0,8,0,0" Text="{Binding Error}" />

        <Grid>
            <TreeView ItemsSource="{Binding Roots}"
                      SelectedItemChanged="Tree_SelectedItemChanged"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding PermissionHint}">
                            <TextBlock Text="{Binding Name}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanUpload}" Value="False">
                                                <Setter Property="Opacity" Value="0.45" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                <Setter Property="FontStyle" Value="Italic" />
                                                <Setter Property="Opacity" Value="0.5" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="8,0,0,0" Opacity="0.5" Text="read-only"
                                       Visibility="{Binding CanUpload, Converter={StaticResource InverseBooleanToVisibility}}" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="Loading..." Opacity="0.6"
                       Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibility}}" />
        </Grid>

    </DockPanel>
</Window>
